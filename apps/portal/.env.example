# Portal Casagrande — variáveis do deploy único
#
# Um só site / um só domínio: Login → Hub → sistema escolhido
# (/dona-lu/... ou /allativa/...), tudo no mesmo host.

# NextAuth — gere com: npx auth secret
AUTH_SECRET="troque-por-um-segredo-aleatorio"

# Credenciais do administrador (login do Hub)
ADMIN_EMAIL="admin@casagrande.com"
ADMIN_PASSWORD="admin123"

# Opcional: URL canônica do site.
# Na Vercel, se omitir, usa automaticamente https://$VERCEL_URL
# NEXT_PUBLIC_PORTAL_URL="https://seu-dominio.vercel.app"
